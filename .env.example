# Postgres
POSTGRES_PASSWORD=change-me

# RabbitMQ
RABBITMQ_USER=transfans
RABBITMQ_PASSWORD=change-me

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me

# JWT — must match across all services, min 32 chars
JWT_SECRET_KEY=change-me-to-a-real-secret-key-min-32-chars

# Internal service-to-service secret
INTERNAL_SECRET=change-me

# GHCR credentials for Watchtower to pull private images
# GHCR_USER = your GitHub username or org bot account
# GHCR_TOKEN = GitHub PAT with read:packages scope
GHCR_USER=your-github-username
GHCR_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx
